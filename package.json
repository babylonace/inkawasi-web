{
  "name": "inkawasi-carta",
  "version": "1.0.0",
  "description": "Carta web multilingüe de Inkawasi (cocina peruana, Ferrol): sitio estático pre-renderizado en 10 idiomas.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsx scripts/prerender.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "optimize:images": "tsx scripts/optimize-images.ts"
  },
  "type": "module",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/jost": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "country-flag-icons": "^1.6.20",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "simple-icons": "^16.35.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
